{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered Darb user profile with role-based moderation status.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "enum": ["user", "superadmin"]
        },
        "isBanned": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "name", "email", "role", "isBanned", "createdAt"]
    },
    "Trip": {
      "title": "Trip",
      "description": "User-submitted hiking trip with route coordinates, elevation profile, and media.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "location": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "dateIso": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "year": {
          "type": "number"
        },
        "difficulty": {
          "type": "string",
          "enum": ["سهل", "متوسط", "صعب"]
        },
        "distanceKm": {
          "type": "number"
        },
        "durationHours": {
          "type": "number"
        },
        "elevationGainM": {
          "type": "number"
        },
        "maxElevationM": {
          "type": "number"
        },
        "minElevationM": {
          "type": "number"
        },
        "notes": {
          "type": "string",
          "maxLength": 4000
        },
        "coverImageUrl": {
          "type": "string",
          "maxLength": 350000
        },
        "gpxUrl": {
          "type": "string",
          "maxLength": 2000
        },
        "gpxFileName": {
          "type": "string",
          "maxLength": 160
        },
        "startLat": {
          "type": "number"
        },
        "startLng": {
          "type": "number"
        },
        "routePoints": {
          "type": "array",
          "description": "Bounded array (max 150) of {lat, lng} trail coordinates."
        },
        "elevationProfile": {
          "type": "array",
          "description": "Bounded array (max 30) of {km, m} elevation samples."
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "title",
        "location",
        "region",
        "dateIso",
        "year",
        "difficulty",
        "distanceKm",
        "durationHours",
        "elevationGainM",
        "maxElevationM",
        "minElevationM",
        "notes",
        "coverImageUrl",
        "startLat",
        "startLng",
        "routePoints",
        "elevationProfile",
        "authorUid",
        "authorName",
        "createdAt"
      ]
    },
    "TripComment": {
      "title": "TripComment",
      "description": "Comment posted on a specific hiking trip.",
      "type": "object",
      "properties": {
        "tripId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "text": {
          "type": "string",
          "minLength": 2,
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["tripId", "authorUid", "authorName", "text", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles containing email, display name, role (user or superadmin), and moderation ban flag."
    },
    "/trips/{tripId}": {
      "schema": { "$ref": "#/entities/Trip" },
      "description": "Publicly readable hiking trips created by non-banned authenticated users, deletable by owner or superadmin."
    },
    "/trips/{tripId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/TripComment" },
      "description": "Comments attached to a parent trip document, readable publicly and deletable by comment author, trip owner, or superadmin."
    }
  }
}
