rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------------------
    // Global Hardened Primitives
    // -----------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCustomUserId(val) {
      return val is string
        && val.size() >= 3
        && val.size() <= 24
        && val.matches('^[a-zA-Z0-9_\\-\\p{Arabic}]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdminEmail() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'az208345@gmail.com';
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        isBootstrappedAdminEmail()
        || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin'
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned == false
        )
      );
    }

    function isActiveUser() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned == false;
    }

    // -----------------------------------------------------------------------
    // Entity Validation Blueprints (Anti-Update-Gap)
    // -----------------------------------------------------------------------
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'isBanned', 'createdAt'])
        && data.keys().hasOnly([
          'uid', 'userId', 'userIdLower', 'name', 'email', 'dateOfBirth', 'favorites', 'role', 'isBanned', 'createdAt'
        ])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && (!('userId' in data) || isValidCustomUserId(data.userId))
        && (!('userIdLower' in data) || isValidCustomUserId(data.userIdLower))
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 160
        && (!('dateOfBirth' in data) || (
          data.dateOfBirth is string && (
            data.dateOfBirth == ''
            || (data.dateOfBirth.size() == 10 && data.dateOfBirth.matches('^\\d{4}-\\d{2}-\\d{2}$'))
          )
        ))
        && (!('favorites' in data) || (
          data.favorites is list && data.favorites.size() <= 200
          && (data.favorites.size() == 0 || (data.favorites[0] is string && data.favorites[0].size() <= 128))
        ))
        && data.role is string && data.role in ['user', 'superadmin']
        && data.isBanned is bool
        && data.createdAt is timestamp;
    }

    function isValidUsernameClaim(data) {
      return data.keys().hasAll(['uid', 'userId', 'normalizedId', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'userId', 'normalizedId', 'updatedAt'])
        && data.uid is string && isValidId(data.uid)
        && isValidCustomUserId(data.userId)
        && isValidCustomUserId(data.normalizedId)
        && data.updatedAt is timestamp;
    }

    function isValidPublicProfile(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'userId', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'userId', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && isValidCustomUserId(data.userId)
        && data.updatedAt is timestamp;
    }

    function isValidTrip(data) {
      return data.keys().hasAll([
          'title', 'location', 'region', 'dateIso', 'year', 'difficulty',
          'distanceKm', 'durationHours', 'elevationGainM', 'maxElevationM', 'minElevationM',
          'notes', 'coverImageUrl', 'startLat', 'startLng', 'routePoints', 'elevationProfile',
          'authorUid', 'authorName', 'createdAt'
        ])
        && data.keys().hasOnly([
          'title', 'location', 'region', 'dateIso', 'year', 'difficulty',
          'distanceKm', 'durationHours', 'elevationGainM', 'maxElevationM', 'minElevationM',
          'notes', 'coverImageUrl', 'gpxUrl', 'gpxFileName', 'startLat', 'startLng',
          'routePoints', 'elevationProfile', 'authorUid', 'authorId', 'authorName', 'authorUserId',
          'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
        && data.location is string && data.location.size() >= 2 && data.location.size() <= 120
        && data.region is string && data.region.size() >= 1 && data.region.size() <= 60
        && data.dateIso is string && data.dateIso.size() == 10 && data.dateIso.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.year is number && data.year >= 2000 && data.year <= 2100
        && data.difficulty is string && data.difficulty in ['سهل', 'متوسط', 'صعب']
        && data.distanceKm is number && data.distanceKm > 0 && data.distanceKm <= 500
        && data.durationHours is number && data.durationHours > 0 && data.durationHours <= 240
        && data.elevationGainM is number && data.elevationGainM >= 0 && data.elevationGainM <= 20000
        && data.maxElevationM is number && data.maxElevationM >= -500 && data.maxElevationM <= 9000
        && data.minElevationM is number && data.minElevationM >= -500 && data.minElevationM <= 9000
        && data.notes is string && data.notes.size() <= 4000
        && data.coverImageUrl is string && data.coverImageUrl.size() <= 350000
        && (!('gpxUrl' in data) || (data.gpxUrl is string && data.gpxUrl.size() <= 2000))
        && (!('gpxFileName' in data) || (data.gpxFileName is string && data.gpxFileName.size() <= 160))
        && data.startLat is number && data.startLat >= -90 && data.startLat <= 90
        && data.startLng is number && data.startLng >= -180 && data.startLng <= 180
        && data.routePoints is list && data.routePoints.size() >= 2 && data.routePoints.size() <= 150
        && data.routePoints[0] is map && data.routePoints[0].lat is number && data.routePoints[0].lng is number
        && data.elevationProfile is list && data.elevationProfile.size() >= 2 && data.elevationProfile.size() <= 30
        && data.elevationProfile[0] is map && data.elevationProfile[0].km is number && data.elevationProfile[0].m is number
        && data.authorUid is string && isValidId(data.authorUid)
        && (!('authorId' in data) || (data.authorId is string && data.authorId == data.authorUid && isValidId(data.authorId)))
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && (!('authorUserId' in data) || (data.authorUserId is string && data.authorUserId.size() <= 32))
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidComment(data, tripId) {
      return data.keys().hasAll(['tripId', 'authorUid', 'authorName', 'text', 'createdAt'])
        && data.keys().hasOnly(['tripId', 'authorUid', 'authorName', 'authorUserId', 'rating', 'text', 'createdAt'])
        && data.tripId is string && data.tripId == tripId && isValidId(data.tripId)
        && data.authorUid is string && isValidId(data.authorUid)
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 80
        && (!('authorUserId' in data) || (data.authorUserId is string && data.authorUserId.size() <= 32))
        && (!('rating' in data) || (data.rating is number && data.rating >= 1 && data.rating <= 5))
        && data.text is string && data.text.size() >= 2 && data.text.size() <= 1000
        && data.createdAt is timestamp;
    }

    function isValidTrailAlert(data, tripId) {
      return data.keys().hasAll(['tripId', 'status', 'note', 'authorUid', 'authorName', 'createdAt'])
        && data.keys().hasOnly(['tripId', 'status', 'note', 'authorUid', 'authorName', 'authorUserId', 'createdAt'])
        && data.tripId is string && data.tripId == tripId && isValidId(data.tripId)
        && data.status is string && data.status in ['الطريق سالك', 'يوجد سيول/وحل', 'يتطلب دفع رباعي', 'مغلق للصيانة']
        && data.note is string && data.note.size() <= 500
        && data.authorUid is string && isValidId(data.authorUid)
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 80
        && (!('authorUserId' in data) || (data.authorUserId is string && data.authorUserId.size() <= 32))
        && data.createdAt is timestamp;
    }

    // -----------------------------------------------------------------------
    // Collection: /users/{userId} (PII Isolated to Owner & SuperAdmin)
    // -----------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isSuperAdmin());
      allow list: if isSuperAdmin();

      allow create: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().isBanned == false
        && (
          incoming().role == 'user'
          || (incoming().role == 'superadmin' && isBootstrappedAdminEmail())
        );

      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && (
          // Action 1: Owner updates profile fields, custom userId, & favorites (cannot touch role or isBanned)
          (
            isOwner(userId)
            && existing().isBanned == false
            && incoming().role == existing().role
            && incoming().isBanned == existing().isBanned
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'dateOfBirth', 'favorites', 'userId', 'userIdLower', 'email'
            ])
          )
          ||
          // Action 2: Super Admin moderates account (ban/unban or role change, never banning self)
          (
            isSuperAdmin()
            && request.auth.uid != userId
            && incoming().email == existing().email
            && incoming().diff(existing()).affectedKeys().hasOnly(['isBanned', 'role'])
          )
        );

      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Collection: /usernames/{handleKey} (Zero-PII Unique Handle Reservations)
    // -----------------------------------------------------------------------
    match /usernames/{handleKey} {
      allow get: if isValidId(handleKey);
      allow list: if false;

      allow create: if isSignedIn()
        && isValidId(handleKey)
        && isValidUsernameClaim(incoming())
        && incoming().uid == request.auth.uid
        && incoming().updatedAt == request.time
        && (isActiveUser() || isSuperAdmin());

      allow update: if isSignedIn()
        && isValidId(handleKey)
        && isValidUsernameClaim(incoming())
        && existing().uid == request.auth.uid
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['userId', 'normalizedId', 'updatedAt'])
        && (isActiveUser() || isSuperAdmin());

      allow delete: if isSignedIn()
        && isValidId(handleKey)
        && (existing().uid == request.auth.uid || isSuperAdmin());
    }

    // -----------------------------------------------------------------------
    // Collection: /publicProfiles/{userId} (Zero-PII Public Member Cards)
    // -----------------------------------------------------------------------
    match /publicProfiles/{userId} {
      allow get: if isValidId(userId);
      allow list: if false;

      allow create: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidPublicProfile(incoming(), userId)
        && incoming().updatedAt == request.time
        && (isActiveUser() || isSuperAdmin());

      allow update: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidPublicProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'userId', 'updatedAt'])
        && (isActiveUser() || isSuperAdmin());

      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Collection: /trips/{tripId}
    // -----------------------------------------------------------------------
    match /trips/{tripId} {
      allow get: if isValidId(tripId);
      allow list: if true;

      allow create: if isSignedIn()
        && isValidId(tripId)
        && isValidTrip(incoming())
        && incoming().authorUid == request.auth.uid
        && (!('authorId' in incoming()) || incoming().authorId == request.auth.uid)
        && incoming().createdAt == request.time
        && (isActiveUser() || isSuperAdmin());

      allow update: if isSignedIn()
        && isValidId(tripId)
        && isValidTrip(incoming())
        && incoming().authorUid == existing().authorUid
        && (!('authorId' in existing()) || incoming().authorId == existing().authorId)
        && incoming().createdAt == existing().createdAt
        && (!('updatedAt' in incoming()) || incoming().updatedAt == request.time)
        && (
          // Action 1: Owner edits their own trip details, notes, or synced author identity
          (
            existing().authorUid == request.auth.uid
            && isActiveUser()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'location', 'region', 'dateIso', 'year', 'difficulty',
              'distanceKm', 'durationHours', 'elevationGainM', 'maxElevationM', 'minElevationM',
              'notes', 'coverImageUrl', 'gpxUrl', 'gpxFileName', 'startLat', 'startLng',
              'routePoints', 'elevationProfile', 'authorName', 'authorUserId', 'updatedAt'
            ])
          )
          ||
          // Action 2: Super Admin edits any trip
          (
            isSuperAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'location', 'region', 'dateIso', 'year', 'difficulty',
              'distanceKm', 'durationHours', 'elevationGainM', 'maxElevationM', 'minElevationM',
              'notes', 'coverImageUrl', 'gpxUrl', 'gpxFileName', 'startLat', 'startLng',
              'routePoints', 'elevationProfile', 'authorName', 'authorUserId', 'updatedAt'
            ])
          )
        );

      allow delete: if isSignedIn()
        && isValidId(tripId)
        && (existing().authorUid == request.auth.uid || isSuperAdmin());

      // ---------------------------------------------------------------------
      // Subcollection: /trips/{tripId}/comments/{commentId} (Master Gate)
      // ---------------------------------------------------------------------
      match /comments/{commentId} {
        allow get: if isValidId(tripId) && isValidId(commentId);
        allow list: if isValidId(tripId);

        allow create: if isSignedIn()
          && isValidId(tripId)
          && isValidId(commentId)
          && isValidComment(incoming(), tripId)
          && incoming().authorUid == request.auth.uid
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/trips/$(tripId))
          && (isActiveUser() || isSuperAdmin());

        allow update: if false;

        allow delete: if isSignedIn()
          && isValidId(tripId)
          && isValidId(commentId)
          && (
            existing().authorUid == request.auth.uid
            || isSuperAdmin()
            || (
              exists(/databases/$(database)/documents/trips/$(tripId))
              && get(/databases/$(database)/documents/trips/$(tripId)).data.authorUid == request.auth.uid
            )
          );
      }

      // ---------------------------------------------------------------------
      // Subcollection: /trips/{tripId}/alerts/{alertId} (Master Gate)
      // ---------------------------------------------------------------------
      match /alerts/{alertId} {
        allow get: if isValidId(tripId) && isValidId(alertId);
        allow list: if isValidId(tripId);

        allow create: if isSignedIn()
          && isValidId(tripId)
          && isValidId(alertId)
          && isValidTrailAlert(incoming(), tripId)
          && incoming().authorUid == request.auth.uid
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/trips/$(tripId))
          && (isActiveUser() || isSuperAdmin());

        allow update: if false;

        allow delete: if isSignedIn()
          && isValidId(tripId)
          && isValidId(alertId)
          && (
            existing().authorUid == request.auth.uid
            || isSuperAdmin()
            || (
              exists(/databases/$(database)/documents/trips/$(tripId))
              && get(/databases/$(database)/documents/trips/$(tripId)).data.authorUid == request.auth.uid
            )
          );
      }
    }
  }
}
